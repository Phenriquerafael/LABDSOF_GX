<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_booking" targetNamespace="https://github.com/Phenriquerafael/LABDSOF_GX/bpmn" exporter="LABDSOF_GX EN-01-02 generator" exporterVersion="1">
  <bpmn:collaboration id="Collab_booking">
    <bpmn:participant id="P_bmc" name="BMC — booking, execution and closure (owner: Dispatch Service)" processRef="Process_booking" />
    <bpmn:participant id="P_issue" name="Issue Service" />
    <bpmn:participant id="P_cal" name="Calendar simulator (external system)" />
    <bpmn:messageFlow id="M_d_book_P_cal" name="booking request" sourceRef="d_book" targetRef="P_cal" />
    <bpmn:messageFlow id="M_d_recon_P_cal" sourceRef="d_recon" targetRef="P_cal" />
    <bpmn:messageFlow id="M_P_cal_d_recon" name="query / answer" sourceRef="P_cal" targetRef="d_recon" />
    <bpmn:messageFlow id="M_d_booked_P_issue" name="booking confirmed" sourceRef="d_booked" targetRef="P_issue" />
    <bpmn:messageFlow id="M_d_compl_P_issue" name="completion reported" sourceRef="d_compl" targetRef="P_issue" />
    <bpmn:messageFlow id="M_P_issue_d_resolved" name="issue resolved or cancelled" sourceRef="P_issue" targetRef="d_resolved" />
  </bpmn:collaboration>
  <bpmn:process id="Process_booking" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_adm" name="Administrator">
        <bpmn:flowNodeRef>a_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_con" name="Contractor">
        <bpmn:flowNodeRef>c_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_dis" name="Dispatch Service">
        <bpmn:flowNodeRef>d_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_confl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_recon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_booked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_compl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d_start" name="Version agreed">
      <bpmn:outgoing>F_d_start_d_book</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="d_book" name="Send booking request [scheduling_pending]">
      <bpmn:incoming>F_d_start_d_book</bpmn:incoming>
      <bpmn:incoming>F_d_found_d_book</bpmn:incoming>
      <bpmn:incoming>F_a_dec_d_book</bpmn:incoming>
      <bpmn:outgoing>F_d_book_d_wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="d_wait" name="">
      <bpmn:incoming>F_d_book_d_wait</bpmn:incoming>
      <bpmn:outgoing>F_d_wait_d_confl</bpmn:outgoing>
      <bpmn:outgoing>F_d_wait_d_conf</bpmn:outgoing>
      <bpmn:outgoing>F_d_wait_d_to</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="d_confl" name="Conflict [rejected]">
      <bpmn:incoming>F_d_wait_d_confl</bpmn:incoming>
      <bpmn:outgoing>F_d_confl_merge1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ED_d_confl" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="d_conf" name="Valid confirmation">
      <bpmn:incoming>F_d_wait_d_conf</bpmn:incoming>
      <bpmn:outgoing>F_d_conf_merge2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ED_d_conf" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="d_to" name="5 s timeout or invalid answer [uncertain]">
      <bpmn:incoming>F_d_wait_d_to</bpmn:incoming>
      <bpmn:outgoing>F_d_to_d_recon</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ED_d_to" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="d_recon" name="Reconcile: query by request ID">
      <bpmn:incoming>F_d_to_d_recon</bpmn:incoming>
      <bpmn:outgoing>F_d_recon_d_found</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="d_found" name="Booking found?">
      <bpmn:incoming>F_d_recon_d_found</bpmn:incoming>
      <bpmn:outgoing>F_d_found_merge2</bpmn:outgoing>
      <bpmn:outgoing>F_d_found_d_book</bpmn:outgoing>
      <bpmn:outgoing>F_d_found_merge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="merge1" name="">
      <bpmn:incoming>F_d_confl_merge1</bpmn:incoming>
      <bpmn:incoming>F_d_found_merge1</bpmn:incoming>
      <bpmn:outgoing>F_merge1_a_handle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_handle" name="Review the scheduling problem">
      <bpmn:incoming>F_merge1_a_handle</bpmn:incoming>
      <bpmn:outgoing>F_a_handle_a_dec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="a_dec" name="Next step?">
      <bpmn:incoming>F_a_handle_a_dec</bpmn:incoming>
      <bpmn:outgoing>F_a_dec_a_manual</bpmn:outgoing>
      <bpmn:outgoing>F_a_dec_d_book</bpmn:outgoing>
      <bpmn:outgoing>F_a_dec_a_cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="a_cancel" name="Cancel requested">
      <bpmn:incoming>F_a_dec_a_cancel</bpmn:incoming>
      <bpmn:signalEventDefinition id="ED_a_cancel" />
    </bpmn:endEvent>
    <bpmn:userTask id="a_manual" name="Confirm booking manually (window, source, reason)">
      <bpmn:incoming>F_a_dec_a_manual</bpmn:incoming>
      <bpmn:outgoing>F_a_manual_merge2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="merge2" name="">
      <bpmn:incoming>F_d_conf_merge2</bpmn:incoming>
      <bpmn:incoming>F_a_manual_merge2</bpmn:incoming>
      <bpmn:incoming>F_d_found_merge2</bpmn:incoming>
      <bpmn:outgoing>F_merge2_d_booked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="d_booked" name="Store booking [booked]">
      <bpmn:incoming>F_merge2_d_booked</bpmn:incoming>
      <bpmn:outgoing>F_d_booked_c_work</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="c_work" name="Do the work (start optional) [in_progress]">
      <bpmn:incoming>F_d_booked_c_work</bpmn:incoming>
      <bpmn:incoming>F_a_rework_c_work</bpmn:incoming>
      <bpmn:outgoing>F_c_work_c_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c_done" name="Submit completion report (cost if known)">
      <bpmn:incoming>F_c_work_c_done</bpmn:incoming>
      <bpmn:outgoing>F_c_done_d_compl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="d_compl" name="Store completion report [completion_reported]">
      <bpmn:incoming>F_c_done_d_compl</bpmn:incoming>
      <bpmn:outgoing>F_d_compl_a_review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="a_review" name="Review the completion report">
      <bpmn:incoming>F_d_compl_a_review</bpmn:incoming>
      <bpmn:outgoing>F_a_review_a_ok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="a_ok" name="Acceptable?">
      <bpmn:incoming>F_a_review_a_ok</bpmn:incoming>
      <bpmn:outgoing>F_a_ok_a_rework</bpmn:outgoing>
      <bpmn:outgoing>F_a_ok_d_resolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_rework" name="Request rework with a reason">
      <bpmn:incoming>F_a_ok_a_rework</bpmn:incoming>
      <bpmn:outgoing>F_a_rework_c_work</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="d_resolved" name="Receive issue resolved or cancelled (Figure 2)">
      <bpmn:incoming>F_a_ok_d_resolved</bpmn:incoming>
      <bpmn:outgoing>F_d_resolved_d_close</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="d_close" name="Close intervention [closed]">
      <bpmn:incoming>F_d_resolved_d_close</bpmn:incoming>
      <bpmn:outgoing>F_d_close_d_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d_end" name="Intervention closed">
      <bpmn:incoming>F_d_close_d_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_d_start_d_book" sourceRef="d_start" targetRef="d_book" />
    <bpmn:sequenceFlow id="F_d_book_d_wait" sourceRef="d_book" targetRef="d_wait" />
    <bpmn:sequenceFlow id="F_d_wait_d_confl" sourceRef="d_wait" targetRef="d_confl" />
    <bpmn:sequenceFlow id="F_d_wait_d_conf" sourceRef="d_wait" targetRef="d_conf" />
    <bpmn:sequenceFlow id="F_d_wait_d_to" sourceRef="d_wait" targetRef="d_to" />
    <bpmn:sequenceFlow id="F_d_conf_merge2" sourceRef="d_conf" targetRef="merge2" />
    <bpmn:sequenceFlow id="F_d_confl_merge1" sourceRef="d_confl" targetRef="merge1" />
    <bpmn:sequenceFlow id="F_d_to_d_recon" sourceRef="d_to" targetRef="d_recon" />
    <bpmn:sequenceFlow id="F_d_recon_d_found" sourceRef="d_recon" targetRef="d_found" />
    <bpmn:sequenceFlow id="F_merge1_a_handle" sourceRef="merge1" targetRef="a_handle" />
    <bpmn:sequenceFlow id="F_a_handle_a_dec" sourceRef="a_handle" targetRef="a_dec" />
    <bpmn:sequenceFlow id="F_a_manual_merge2" sourceRef="a_manual" targetRef="merge2" />
    <bpmn:sequenceFlow id="F_merge2_d_booked" sourceRef="merge2" targetRef="d_booked" />
    <bpmn:sequenceFlow id="F_d_booked_c_work" sourceRef="d_booked" targetRef="c_work" />
    <bpmn:sequenceFlow id="F_c_work_c_done" sourceRef="c_work" targetRef="c_done" />
    <bpmn:sequenceFlow id="F_c_done_d_compl" sourceRef="c_done" targetRef="d_compl" />
    <bpmn:sequenceFlow id="F_d_compl_a_review" sourceRef="d_compl" targetRef="a_review" />
    <bpmn:sequenceFlow id="F_a_review_a_ok" sourceRef="a_review" targetRef="a_ok" />
    <bpmn:sequenceFlow id="F_d_resolved_d_close" sourceRef="d_resolved" targetRef="d_close" />
    <bpmn:sequenceFlow id="F_d_close_d_end" sourceRef="d_close" targetRef="d_end" />
    <bpmn:sequenceFlow id="F_d_found_merge2" name="yes" sourceRef="d_found" targetRef="merge2" />
    <bpmn:sequenceFlow id="F_d_found_d_book" name="no, retries left" sourceRef="d_found" targetRef="d_book" />
    <bpmn:sequenceFlow id="F_d_found_merge1" name="no, retries exhausted" sourceRef="d_found" targetRef="merge1" />
    <bpmn:sequenceFlow id="F_a_dec_a_manual" name="manual" sourceRef="a_dec" targetRef="a_manual" />
    <bpmn:sequenceFlow id="F_a_dec_d_book" name="retry" sourceRef="a_dec" targetRef="d_book" />
    <bpmn:sequenceFlow id="F_a_dec_a_cancel" name="cancel" sourceRef="a_dec" targetRef="a_cancel" />
    <bpmn:sequenceFlow id="F_a_ok_a_rework" name="no" sourceRef="a_ok" targetRef="a_rework" />
    <bpmn:sequenceFlow id="F_a_ok_d_resolved" name="yes" sourceRef="a_ok" targetRef="d_resolved" />
    <bpmn:sequenceFlow id="F_a_rework_c_work" sourceRef="a_rework" targetRef="c_work" />
    <bpmn:subProcess id="S_cancel" name="Cancellation (any active state before the completion report)" triggeredByEvent="true">
      <bpmn:startEvent id="x_start" name="Cancel requested">
        <bpmn:outgoing>F_x_start_x_ext</bpmn:outgoing>
        <bpmn:signalEventDefinition id="ED_x_start" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="x_ext" name="Cancel or reconcile the external booking [cancellation_pending]">
        <bpmn:incoming>F_x_start_x_ext</bpmn:incoming>
        <bpmn:outgoing>F_x_ext_x_end</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="x_end" name="Intervention cancelled">
        <bpmn:incoming>F_x_ext_x_end</bpmn:incoming>
        <bpmn:messageEventDefinition id="ED_x_end" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_x_start_x_ext" sourceRef="x_start" targetRef="x_ext" />
      <bpmn:sequenceFlow id="F_x_ext_x_end" sourceRef="x_ext" targetRef="x_end" />
    </bpmn:subProcess>
  </bpmn:process>
